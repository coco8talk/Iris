<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.iris</groupId>
  <artifactId>tool-gateway</artifactId>
  <version>0.1.0</version>

  <properties>
    <java.version>17</java.version>
    <!-- 依赖版本统一管理 -->
    <hutool.version>5.8.47</hutool.version>
    <sqlite-jdbc.version>3.47.1.0</sqlite-jdbc.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <lombok.version>1.18.46</lombok.version>
    <knife4j.version>4.5.0</knife4j.version>
    <springdoc.version>2.8.17</springdoc.version>
    <!-- 以下三项覆盖 Boot 管理版本以修复依赖漏洞告警(Mend.io) -->
    <!-- CVE-2025-48924 修复于 3.18.0,Boot 3.5.16 仍管理 3.17.0 -->
    <commons-lang3.version>3.20.0</commons-lang3.version>
    <!-- 告警含 9.1 分高危 CVE,补丁级抬到当前最新 -->
    <tomcat.version>10.1.57</tomcat.version>
    <!-- WS-2026-0003,补丁级抬到当前最新 -->
    <jackson-bom.version>2.21.5</jackson-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- hutool BOM:统一管理 hutool-core / hutool-json 等子模块版本 -->
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-bom</artifactId>
        <version>${hutool.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ========== Web 与参数校验 ========== -->
    <!-- Spring MVC Web 框架 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Bean Validation 参数校验(@Valid / @NotBlank 等) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ========== 数据库 ========== -->
    <!-- SQLite JDBC 驱动 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <!-- MyBatis-Plus ORM(Spring Boot 3 版本) -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- ========== JSON 与工具类 ========== -->
    <!-- hutool 核心工具(StrUtil 等) -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-core</artifactId>
    </dependency>
    <!-- hutool JSON 工具(JSONUtil) -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-json</artifactId>
    </dependency>

    <!-- ========== 接口文档 ========== -->
    <!-- knife4j 接口文档 UI(OpenAPI3,访问 /doc.html) -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
      <version>${knife4j.version}</version>
    </dependency>
    <!-- springdoc OpenAPI3:knife4j 4.5.0 自带版本过旧,显式升级以兼容 Spring Boot 3.4 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ========== 开发辅助 ========== -->
    <!-- Lombok:编译期生成 getter/setter/builder -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
    </dependency>

    <!-- ========== 测试 ========== -->
    <!-- Spring Boot 测试(JUnit5 + MockMvc + AssertJ) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>